        {
          "name": "Pagar con la pasarela simulada",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/pedido/pagar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pedido",
                "pagar"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Prueba Postman\",\n  \"medio\": \"Correo\",\n  \"valor\": \"prueba@example.invalid\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "    const pedido = pm.response.json();",
                  "    pm.test(\"Pago confirmado\", () => pm.expect(pedido.pago.estado).to.eql(\"Confirmado\"));",
                  "    pm.collectionVariables.set(\"pedidoId\", pedido.id);",
                  "    pm.collectionVariables.set(\"numeroPedido\", pedido.numeroPedido);",
                  "}"
                ]
              }
            }
          ]
        }
