@startuml vista-funcional-componentes
' ============================================================
' Vista funcional (Rozanski & Woods) - Sistema de Autoservicio
' Elementos funcionales, interfaces ofrecidas/requeridas y dependencias.
' ============================================================
skinparam linetype ortho
skinparam componentStyle rectangle
skinparam nodesep 30
skinparam ranksep 40

package "Interfaz de usuario" {
  [KioscoCliente] as Kiosco
  [PantallaCocina] as PCocina
  [PanelAdministracion] as PAdmin
  [PantallaMesero] as PMesero
}

package "Dominio funcional" {
  [GestionMenu] as Menu
  [GestionPedidos] as Pedidos
  [MotorCocina] as Cocina
  [ControlRiel] as Riel
  [GestionMesas] as Mesas
  [GestionInventario] as Inventario
}

package "Servicios transversales" {
  [Notificaciones] as Notif
  [Reportes] as Rep
  [Administracion] as Admin
}

package "Sistemas externos" {
  [PasarelaPago] as PagoExt
  [SistemaRielExterno] as RielExt
}

' --- Interfaces ofrecidas ---
() "IMenu" as IMenu
() "IPedidos" as IPedidos
() "ICocina" as ICocina
() "IRiel" as IRiel
() "IMesas" as IMesas
() "IInventario" as IInventario
() "INotificaciones" as INotif
() "IReportes" as IReportes
() "IPago" as IPago
() "IRielExterno" as IRielExt

Menu -up- IMenu
Pedidos -up- IPedidos
Cocina -up- ICocina
Riel -up- IRiel
Mesas -up- IMesas
Inventario -up- IInventario
Notif -up- INotif
Rep -up- IReportes
PagoExt -up- IPago
RielExt -up- IRielExt

' --- Dependencias (interfaces requeridas) ---
Kiosco ..> IMenu
Kiosco ..> IPedidos
Kiosco ..> IPago

Pedidos ..> IMenu
Pedidos ..> IInventario
Pedidos ..> ICocina
Pedidos ..> IMesas
Pedidos ..> IPago

Cocina ..> IPedidos
Cocina ..> INotif

Riel ..> IPedidos
Riel ..> IMesas
Riel ..> IRielExt

Inventario ..> IMenu
Inventario ..> INotif

Notif ..> IReportes

Rep ..> IPedidos
Rep ..> ICocina

PCocina ..> ICocina
PMesero ..> IMesas
PAdmin ..> IReportes
PAdmin ..> IMenu

note right of Pedidos
  Componente central: coordina
  menu, inventario, cocina, mesas
  y pago (RF-15..RF-27).
end note

note bottom of Riel
  RF-35..RF-38: transporte
  cocina -> mesa y fallas.
end note
@enduml
