@startuml diagrama-clases
' ============================================================
' Diagrama de clases - Sistema de Autoservicio para Restaurante
' Diseno de software en 4 paquetes: dominio / aplicacion / infraestructura / interfaz.
' NO existe codigo fuente todavia: este diagrama es el diseno propuesto.
' ============================================================
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam nodesep 35
skinparam ranksep 45
skinparam packageStyle rectangle
hide circle

package "dominio" {

  package "alertas" {
    abstract class Alerta {
      - id : UUID
      - descripcion : String
      - fechaHoraGeneracion : LocalDateTime
      - atendida : boolean
      + atender() : void
      + estaAtendida() : boolean
    }
    class AlertaRetraso {
      - minutosRetraso : int
    }
    class AlertaStockBajo {
      - stockActual : BigDecimal
      - stockMinimo : BigDecimal
    }
    class AlertaFallaTransporte {
      - descripcionFalla : String
    }
    Alerta <|-- AlertaRetraso
    Alerta <|-- AlertaStockBajo
    Alerta <|-- AlertaFallaTransporte
  }

  class Categoria {
    - id : UUID
    - nombre : String
    - ordenVisualizacion : int
    - activa : boolean
    + activar() : void
    + desactivar() : void
  }

  class Producto {
    - id : UUID
    - codigo : String
    - nombre : String
    - descripcion : String
    - precioBase : BigDecimal
    - imagen : String
    - tiempoPreparacionMinutos : int
    - disponible : boolean
    + calcularPrecio(ajusteVariante : BigDecimal, extras : List~BigDecimal~) : BigDecimal
    + marcarAgotado() : void
    + estaDisponible() : boolean
  }

  class VarianteProducto {
    - id : UUID
    - nombre : String
    - ajustePrecio : BigDecimal
    - orden : int
    - activa : boolean
  }

  class Ingrediente {
    - id : UUID
    - codigo : String
    - nombre : String
    - unidadMedida : String
    - stockActual : BigDecimal
    - stockMinimo : BigDecimal
    - costoUnitario : BigDecimal
    + tieneStock(cantidad : BigDecimal) : boolean
    + aplicarMovimiento(movimiento : MovimientoInventario) : void
    + requiereReposicion() : boolean
  }

  class RecetaProducto <<clase de asociación>> {
    - cantidadRequerida : BigDecimal
    - esOpcional : boolean
    - cargoExtra : BigDecimal
  }

  class ComplementoProducto <<clase de asociación>> {
    - obligatorio : boolean
    - orden : int
  }

  class Carrito {
    - id : UUID
    - fechaHoraApertura : LocalDateTime
    - estado : EstadoCarrito
    - lineas : List~LineaPedido~
    + agregarProducto(producto : Producto, cantidad : int) : void
    + quitarProducto(lineaId : UUID) : void
    + calcularTotal() : BigDecimal
    + confirmar() : Pedido
  }

  class Pedido {
    - id : UUID
    - codigo : String
    - fechaHoraCreacion : LocalDateTime
    - tipo : TipoPedido
    - estado : EstadoPedido
    - observaciones : String
    - motivoCancelacion : String
    - lineas : List~LineaPedido~
    + {static} generarCodigo(fecha : LocalDate) : String
    + agregarLinea(linea : LineaPedido) : void
    + confirmar() : void
    + cancelar(motivo : String) : void
    + calcularTotal() : BigDecimal
    + cambiarEstado(nuevo : EstadoPedido) : void
  }

  class LineaPedido {
    - id : UUID
    - cantidad : int
    - precioUnitario : BigDecimal
    - notasPersonalizacion : String
    + calcularSubtotal() : BigDecimal
  }

  class PersonalizacionIngrediente <<clase de asociación>> {
    - accion : AccionPersonalizacion
    - cantidadExtra : BigDecimal
    - cargoExtra : BigDecimal
  }

  class ComplementoSeleccionado <<clase de asociación>> {
    - cantidad : int
    - precioUnitario : BigDecimal
  }

  class Pago {
    - id : UUID
    - monto : BigDecimal
    - medio : MedioPago
    - fechaHora : LocalDateTime
    - estado : EstadoPago
    + aprobar() : void
    + rechazar() : void
  }

  class Mesa {
    - id : UUID
    - numero : String
    - capacidad : int
    - ubicacion : String
    - estado : EstadoMesa
    + ocupar() : void
    + liberar() : void
    + estaLibre() : boolean
  }

  class EstacionCocina {
    - id : UUID
    - nombre : String
    - activa : boolean
    + activar() : void
    + desactivar() : void
  }

  class TareaCocina {
    - id : UUID
    - estado : EstadoTareaCocina
    - fechaHoraInicio : LocalDateTime
    - fechaHoraFin : LocalDateTime
    - tiempoEstimadoMinutos : int
    - prioridad : int
    + iniciar() : void
    + completar() : void
    + estaRetrasada(ahora : LocalDateTime) : boolean
  }

  class TransporteRiel {
    - id : UUID
    - estado : EstadoTransporte
    - fechaHoraDespacho : LocalDateTime
    - fechaHoraEntrega : LocalDateTime
    - descripcionFalla : String
    + despachar() : void
    + entregar() : void
    + reportarFalla(descripcion : String) : void
  }

  class MovimientoInventario {
    - id : UUID
    - tipo : TipoMovimiento
    - cantidad : BigDecimal
    - fechaHora : LocalDateTime
    - motivo : String
  }

  enum EstadoCarrito { Abierto Confirmado Abandonado }
  enum TipoPedido { EnRestaurante ParaLlevar }
  enum EstadoPedido { Pendiente Confirmado EnPreparacion ListoParaEntregar EnTransporte Entregado Cancelado Pagado }
  enum EstadoMesa { Libre Ocupada Reservada EnLimpieza }
  enum EstadoTareaCocina { Pendiente EnProceso Completada Cancelada }
  enum EstadoTransporte { PendienteDespacho EnTransporte EntregadoEnMesa Falla }
  enum TipoMovimiento { Entrada SalidaPedido AjustePositivo AjusteNegativo Merma }
  enum AccionPersonalizacion { Quitado AgregadoExtra }
  enum MedioPago { Efectivo Tarjeta Externo }
  enum EstadoPago { Pendiente Aprobado Rechazado }
}

package "aplicacion" {
  interface RepositorioPedidos {
    + guardar(pedido : Pedido) : void
    + buscarPorId(id : UUID) : Pedido
    + listarPorEstado(estado : EstadoPedido) : List~Pedido~
  }
  interface RepositorioProductos {
    + guardar(producto : Producto) : void
    + buscarPorId(id : UUID) : Producto
    + listarDisponibles() : List~Producto~
  }
  interface RepositorioIngredientes {
    + guardar(ingrediente : Ingrediente) : void
    + buscarPorId(id : UUID) : Ingrediente
    + listarBajoMinimo() : List~Ingrediente~
  }
  interface RepositorioMesas {
    + guardar(mesa : Mesa) : void
    + buscarPorNumero(numero : String) : Mesa
    + listarLibres() : List~Mesa~
  }
  interface RepositorioTareas {
    + guardar(tarea : TareaCocina) : void
    + listarPorEstacion(idEstacion : UUID) : List~TareaCocina~
  }
  interface PuertoTransporteRiel {
    + despachar(transporte : TransporteRiel) : void
    + consultarEstado(idTransporte : UUID) : EstadoTransporte
  }
  interface EstrategiaPago {
    + procesar(monto : BigDecimal) : boolean
  }
  interface ObservadorPedido {
    + actualizar(pedido : Pedido, evento : String) : void
  }
  interface Notificador {
    + enviar(destino : String, mensaje : String) : void
  }

  class ServicioPedidos {
    + crearDesdeCarrito(carrito : Carrito) : Pedido
    + confirmarPedido(idPedido : UUID) : void
    + cancelarPedido(idPedido : UUID, motivo : String) : void
    + registrarPago(idPedido : UUID, estrategia : EstrategiaPago) : boolean
  }
  class ServicioMenu {
    + listarMenu() : List~Producto~
    + buscarProducto(id : UUID) : Producto
  }
  class ServicioCocina {
    + enviarAEstaciones(pedido : Pedido) : void
    + iniciarTarea(idTarea : UUID) : void
    + completarTarea(idTarea : UUID) : void
  }
  class ServicioRiel {
    + despacharPedido(idPedido : UUID) : void
    + reportarFalla(idTransporte : UUID, descripcion : String) : void
  }
  class ServicioInventario {
    + descontarPorPedido(pedido : Pedido) : void
    + registrarMovimiento(movimiento : MovimientoInventario) : void
    + ingredientesBajoMinimo() : List~Ingrediente~
  }
  class ServicioMesas {
    + ocuparMesa(numero : String) : void
    + liberarMesa(numero : String) : void
  }
  class ServicioReportes {
    + ventasPorProducto() : Map~String,BigDecimal~
    + rendimientoPorEstacion() : Map~String,Double~
  }
  class ServicioAlertas <<Observer>> {
    + actualizar(pedido : Pedido, evento : String) : void
  }
}

package "infraestructura" {
  class RepositorioPedidosEnMemoria implements RepositorioPedidos
  class RepositorioProductosEnMemoria implements RepositorioProductos
  class RepositorioIngredientesEnMemoria implements RepositorioIngredientes
  class RepositorioMesasEnMemoria implements RepositorioMesas
  class RepositorioTareasEnMemoria implements RepositorioTareas
  class AdaptadorRiel implements PuertoTransporteRiel
  class PagoEfectivo implements EstrategiaPago
  class PagoTarjeta implements EstrategiaPago
  class NotificadorCorreo implements Notificador
}

package "interfaz" {
  class PantallaKiosco {
    + iniciarPedido() : Carrito
    + agregarAlCarrito(idProducto : UUID, cantidad : int) : void
    + confirmarPedido() : Pedido
  }
  class PantallaCocina {
    + verTareas(idEstacion : UUID) : List~TareaCocina~
    + completarTarea(idTarea : UUID) : void
  }
  class PantallaMesero {
    + verEstadoMesa(numero : String) : EstadoMesa
  }
  class PanelAdministracion {
    + gestionarProducto(producto : Producto) : void
    + verReporte(nombre : String) : Map~String,Object~
  }
}

' --- Relaciones del dominio ---
Categoria "1" o-- "0..*" Producto : agrupa >
Producto "1" *-- "0..*" VarianteProducto : ofrece >
Producto "1" *-- "0..*" RecetaProducto : define >
RecetaProducto "*" --> "1" Ingrediente : usa >
Producto "1" --> "0..*" ComplementoProducto : ofrece >
ComplementoProducto "*" --> "1" Producto : complementa >
Producto "*" --> "1" EstacionCocina : se prepara en >

Carrito "1" *-- "0..*" LineaPedido : reúne >
Carrito "0..1" --> "0..1" Pedido : se confirma como >
Pedido "1" *-- "1..*" LineaPedido : contiene >
LineaPedido "*" --> "1" Producto : refiere a >
LineaPedido "*" --> "0..1" VarianteProducto : usa >
LineaPedido "1" *-- "0..*" PersonalizacionIngrediente : personaliza >
PersonalizacionIngrediente "*" --> "1" Ingrediente : refiere a >
LineaPedido "1" *-- "0..*" ComplementoSeleccionado : incluye >
ComplementoSeleccionado "*" --> "1" Producto : refiere a >
Pago "1" --> "1" Pedido : corresponde a >
Pedido "0..*" --> "0..1" Mesa : se atiende en >
Pedido "1" *-- "0..*" TareaCocina : genera >
TareaCocina "*" --> "1" EstacionCocina : se realiza en >
TareaCocina "*" --> "1" LineaPedido : prepara >
Pedido "0..1" *-- "0..1" TransporteRiel : se transporta mediante >
TransporteRiel "*" --> "1" Mesa : se dirige a >
Ingrediente "1" --> "0..*" MovimientoInventario : registra >
MovimientoInventario "*" --> "0..1" Pedido : se origina por >

' --- Aplicación: dependencias de servicios ---
ServicioPedidos ..> RepositorioPedidos
ServicioPedidos ..> RepositorioMesas
ServicioPedidos ..> EstrategiaPago
ServicioPedidos ..> Carrito
ServicioPedidos ..> Pedido
ServicioMenu ..> RepositorioProductos
ServicioCocina ..> RepositorioTareas
ServicioCocina ..> Pedido
ServicioRiel ..> PuertoTransporteRiel
ServicioRiel ..> TransporteRiel
ServicioInventario ..> RepositorioIngredientes
ServicioInventario ..> MovimientoInventario
ServicioMesas ..> RepositorioMesas
ServicioAlertas ..> Alerta
ServicioAlertas ..> Notificador
Pedido o--> ObservadorPedido : notifica
ServicioAlertas ..|> ObservadorPedido

' --- Interfaz de usuario ---
PantallaKiosco ..> ServicioMenu
PantallaKiosco ..> ServicioPedidos
PantallaCocina ..> ServicioCocina
PantallaMesero ..> ServicioMesas
PanelAdministracion ..> ServicioReportes
PanelAdministracion ..> ServicioMenu

note bottom of ServicioPedidos
  Patrón <<Facade>>: los servicios de aplicación
  exponen operaciones de caso de uso y ocultan
  el dominio a la capa de interfaz.
end note

note bottom of Pedido
  Patrón <<Observer>>: Pedido notifica a
  ObservadorPedido (ServicioAlertas) ante cambios
  de estado relevantes.
end note

note bottom of EstrategiaPago
  Patrón <<Strategy>>: distintas formas de pago
  (efectivo, tarjeta, externo) intercambiables.
end note

note bottom of RepositorioPedidos
  Patrón <<Repository>>: abstrae la persistencia;
  las implementaciones viven en infraestructura.
end note

note bottom of PuertoTransporteRiel
  Patrón <<Adapter>>: AdaptadorRiel traduce el
  dominio al sistema externo de riel.
end note
@enduml
